---
import { certifications } from '../data/certifications';
---

<section id="certifications" class="py-14 sm:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-text-500 mb-8 flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-accent-500 flex-shrink-0"></span>
        Certifications
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {certifications.map((cert) => (
          <div class="content-card flex flex-col items-center text-center gap-2 p-3 group">
            <div class="shrink-0 w-8 h-8 flex items-center justify-center bg-primary-50 rounded-lg text-primary-600 group-hover:scale-110 group-hover:bg-accent-500 group-hover:text-background-100 transition-all duration-300">
              <!-- Certificate Icon -->
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-text-500 leading-snug">{cert.name}</h3>
              <p class="text-text-500/70 text-xs font-bold uppercase tracking-wider mt-1">{cert.issuer}</p>
              <p class="text-text-500/50 text-xs mt-0.5">{cert.date}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
