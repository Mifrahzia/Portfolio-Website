---
import { siteConfig } from '../data/site';

const navLinks = [
  { name: 'Projects', href: '#projects' },
  { name: 'Experience', href: '#experience' },
];
---

<header class="fixed top-4 inset-x-0 z-50 flex justify-center px-4">
  <div class="w-full max-w-2xl flex items-center justify-between gap-3 rounded-full bg-background-100/90 backdrop-blur-md border border-primary-200 shadow-lg px-4 py-2">
    <!-- Logo / Name -->
    <a href="#" class="flex-shrink-0 text-base font-bold tracking-tight text-text-500 hover:text-accent-500 transition-colors px-1">
      {siteConfig.name}
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-bold uppercase tracking-wider text-text-500 hover:text-accent-500 transition-colors"
        >
          {link.name}
        </a>
      ))}

      <div class="flex items-center gap-3 pl-1">
        <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="text-text-500 hover:text-accent-500 transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
        </a>
        <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-text-500 hover:text-accent-500 transition-colors" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"></path></svg>
        </a>
      </div>

      <a
        href="#contact"
        class="inline-flex items-center justify-center px-4 py-1.5 text-sm font-bold uppercase tracking-wide text-background-100 bg-primary-500 rounded-full hover:bg-accent-500 transition-colors duration-300 active:animate-press"
      >
        Contact
      </a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <div class="flex md:hidden">
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex items-center justify-center rounded-full p-2 text-text-500 hover:bg-primary-100 hover:text-primary-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger icon -->
        <svg
          class="block h-5 w-5"
          id="icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon (hidden by default) -->
        <svg
          class="hidden h-5 w-5"
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Panel -->
  <div class="hidden md:hidden absolute top-full mt-2 w-[calc(100%-2rem)] max-w-2xl" id="mobile-menu">
    <div class="space-y-1 p-3 rounded-2xl shadow-lg bg-background-100 border border-primary-200">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block rounded-lg px-3 py-2 text-base font-bold text-text-500 hover:bg-primary-100 hover:text-primary-700 transition-colors mobile-link"
        >
          {link.name}
        </a>
      ))}
      <a href="#contact" class="block rounded-lg px-3 py-2 text-base font-bold text-text-500 hover:bg-primary-100 hover:text-primary-700 transition-colors mobile-link">
        Contact
      </a>
      <div class="flex items-center gap-5 px-3 pt-2">
        <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="text-text-500 hover:text-accent-500 transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
        </a>
        <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-text-500 hover:text-accent-500 transition-colors" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"></path></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Vanilla JS for the mobile hamburger toggle per zero-JS mandate
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (mobileMenuToggle && mobileMenu && iconMenu && iconClose) {
    const toggleMenu = () => {
      const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
      mobileMenuToggle.setAttribute('aria-expanded', (!isExpanded).toString());

      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('block');
      iconClose.classList.toggle('hidden');
      iconClose.classList.toggle('block');
    };

    mobileMenuToggle.addEventListener('click', toggleMenu);

    // Close mobile menu automatically when a link is clicked
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }
</script>
