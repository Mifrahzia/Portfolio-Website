---
import { siteConfig } from '../data/site';
---

<section id="contact" class="py-14 sm:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl sm:text-5xl font-bold text-text-500 mb-6">Let's Connect</h2>
      <p class="text-base text-text-500/80 mb-6 max-w-2xl mx-auto leading-relaxed">
        I am currently looking for new opportunities. Whether you have a question, a project idea, or just want to say hi, my inbox is always open!
      </p>

      <p class="font-bold text-text-500 mb-8">{siteConfig.email}</p>

      <form id="contact-form" class="content-card text-left grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="flex flex-col gap-1.5">
          <label for="contact-name" class="text-sm font-bold text-text-500">Name</label>
          <input id="contact-name" name="name" type="text" placeholder="Your name"
            class="rounded-lg border border-primary-200 bg-background-100 px-4 py-2.5 text-text-500 placeholder:text-text-500/40 focus:outline-none focus:border-accent-400 transition-colors" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="contact-email" class="text-sm font-bold text-text-500">Email <span class="font-normal text-text-500/50">(required)</span></label>
          <input id="contact-email" name="email" type="email" required placeholder="you@company.com"
            class="rounded-lg border border-primary-200 bg-background-100 px-4 py-2.5 text-text-500 placeholder:text-text-500/40 focus:outline-none focus:border-accent-400 transition-colors" />
        </div>

        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="contact-phone" class="text-sm font-bold text-text-500">Phone <span class="font-normal text-text-500/50">(optional)</span></label>
          <input id="contact-phone" name="phone" type="tel" placeholder="+92 3XX XXXXXXX"
            class="rounded-lg border border-primary-200 bg-background-100 px-4 py-2.5 text-text-500 placeholder:text-text-500/40 focus:outline-none focus:border-accent-400 transition-colors" />
        </div>

        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="contact-message" class="text-sm font-bold text-text-500">Message <span class="font-normal text-text-500/50">(required)</span></label>
          <textarea id="contact-message" name="message" required rows="4" placeholder="What are you building?"
            class="rounded-lg border border-primary-200 bg-background-100 px-4 py-2.5 text-text-500 placeholder:text-text-500/40 focus:outline-none focus:border-accent-400 transition-colors resize-none"></textarea>
        </div>

        <button type="submit"
          class="sm:col-span-2 flex items-center justify-center gap-2 mt-1 px-8 py-3.5 bg-primary-500 hover:bg-accent-500 text-background-100 rounded-full font-bold transition-colors duration-300 active:animate-press">
          Send Message
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ contactEmail: siteConfig.email }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name');
    const email = data.get('email');
    const phone = data.get('phone');
    const message = data.get('message');

    const subject = name ? `Portfolio inquiry from ${name}` : 'Portfolio inquiry';
    const bodyLines = [
      name ? `Name: ${name}` : null,
      `Email: ${email}`,
      phone ? `Phone: ${phone}` : null,
      '',
      message,
    ].filter((line) => line !== null);

    const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
    window.location.href = mailto;
  });
</script>
