---
import projects from '../data/projects.json';
import ExpandableProjects from './react/ExpandableProjects';
---

<section id="projects" class="py-14 sm:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-text-500 mb-8 flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-accent-500 flex-shrink-0"></span>
        Featured Projects
      </h2>

      <ExpandableProjects client:load projects={projects} />
    </div>
  </div>
</section>
