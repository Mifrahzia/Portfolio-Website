---
import { experience } from '../data/experience';
---

<section id="experience" class="py-24 sm:py-32 bg-slate-900/50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-100 mb-12 flex items-center gap-4">
        <span class="w-8 h-1 bg-teal-500 rounded-full"></span>
        Experience
      </h2>
      
      <div class="grid gap-6">
        {experience.map((exp) => (
          <div class="group p-8 rounded-2xl bg-slate-900 border border-slate-800 hover:border-teal-500/30 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-lg">
            <div>
              <h3 class="text-2xl font-bold text-slate-100 mb-2 group-hover:text-teal-400 transition-colors">{exp.role}</h3>
              <p class="text-lg text-slate-400 font-medium">{exp.company}</p>
            </div>
            
            <div class="hidden sm:flex shrink-0 w-14 h-14 rounded-full bg-slate-800 items-center justify-center text-slate-400 group-hover:bg-teal-500 group-hover:text-slate-950 transition-colors duration-300">
              <!-- Briefcase icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
