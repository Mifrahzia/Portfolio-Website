---
import '../styles/global.css';
import { siteConfig } from '../data/site';
import ConstellationBackground from '../components/ConstellationBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.tagline } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- TODO: Add a custom favicon (public/favicon.svg or .ico) and re-add the <link rel="icon"> tag -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;700&display=swap" rel="stylesheet">
    <title>{title} | {siteConfig.name}</title>
  </head>
  <body class="text-text-500 font-sans selection:bg-primary-100 selection:text-primary-700">
    <div class="relative min-h-screen flex flex-col">
      <ConstellationBackground />
      <div class="relative z-10 flex flex-col flex-grow">
        <slot />
      </div>
    </div>
  </body>
</html>
