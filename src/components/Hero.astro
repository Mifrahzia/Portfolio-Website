---
import { siteConfig } from '../data/site';
---

<section id="hero" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <!-- Abstract background glow elements -->
  <div class="absolute inset-0 z-0 flex items-center justify-center pointer-events-none">
    <div class="absolute w-[600px] h-[600px] bg-maroon-300/30 rounded-full blur-3xl opacity-60 animate-pulse"></div>
    <div class="absolute w-[500px] h-[500px] bg-emerald-300/30 rounded-full blur-3xl opacity-60 -translate-y-12 translate-x-20"></div>
    <div class="absolute w-[400px] h-[400px] bg-brown-200/30 rounded-full blur-3xl opacity-60 translate-y-16 -translate-x-24"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="space-y-8 max-w-4xl mx-auto">
      <!-- Greeting -->
      <h2 class="text-emerald-600 font-semibold tracking-widest uppercase text-sm sm:text-base opacity-0 animate-[fadeInDown_1s_ease-out_forwards]">
        Hi, my name is
      </h2>

      <!-- Name -->
      <h1 class="text-6xl sm:text-8xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-maroon-600 to-brown-600 opacity-0 animate-[fadeInUp_1s_ease-out_0.2s_forwards]">
        {siteConfig.name}
      </h1>

      <!-- Title -->
      <p class="text-2xl sm:text-3xl font-semibold text-neutral-800 opacity-0 animate-[fadeInUp_1s_ease-out_0.3s_forwards]">
        {siteConfig.title}
      </p>

      <!-- Tagline -->
      <p class="mt-6 text-xl sm:text-2xl text-neutral-600 max-w-2xl mx-auto font-light leading-relaxed opacity-0 animate-[fadeInUp_1s_ease-out_0.4s_forwards]">
        {siteConfig.tagline}
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center opacity-0 animate-[fadeInUp_1s_ease-out_0.6s_forwards]">
        <a 
          href="#projects" 
          class="inline-flex items-center justify-center px-8 py-3.5 text-base font-medium text-white bg-gradient-to-r from-emerald-600 via-maroon-600 to-brown-600 border border-transparent rounded-full hover:from-emerald-500 hover:via-maroon-500 hover:to-brown-500 shadow-[0_0_20px_rgba(143,47,63,0.3)] hover:shadow-[0_0_25px_rgba(143,47,63,0.45)] transition-all duration-300 transform hover:-translate-y-1"
        >
          View Projects
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-8 py-3.5 text-base font-medium text-neutral-700 bg-white/60 border border-surface-300 rounded-full hover:bg-white hover:text-neutral-900 transition-all duration-300 transform hover:-translate-y-1"
        >
          Contact Me
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
