---
import { siteConfig } from '../data/site';
---

<section id="hero" class="relative overflow-hidden">
  <!-- Soft glow behind the hero copy (the scattered constellation itself is a page-wide layer in BaseLayout) -->
  <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_65%_35%,rgba(52,67,0,0.10),transparent_70%)]"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-10 md:gap-12 items-center max-w-4xl mx-auto">
      <!-- Copy -->
      <div class="text-center md:text-left">
        <h1 class="text-5xl text-text-500 font-bold tracking-tight opacity-0 animate-fade-in-up">
          {siteConfig.name}
        </h1>

        <p class="mt-5 text-xl text-text-500/80 max-w-md mx-auto md:mx-0 leading-relaxed opacity-0 animate-fade-in-up [animation-delay:150ms]">
          {siteConfig.tagline}
        </p>

        <div class="mt-6 flex gap-5 justify-center md:justify-start opacity-0 animate-fade-in-up [animation-delay:250ms]">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="text-text-500 hover:text-accent-500 transition-colors" aria-label="GitHub">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          </a>
          <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-text-500 hover:text-accent-500 transition-colors" aria-label="LinkedIn">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"></path></svg>
          </a>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center md:justify-start opacity-0 animate-fade-in-up [animation-delay:350ms]">
          <a
            href="#projects"
            class="inline-flex items-center justify-center px-7 py-3 text-sm font-bold uppercase tracking-wide text-background-100 bg-primary-500 rounded-full hover:bg-accent-500 transition-colors duration-300 active:animate-press"
          >
            View Projects
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-7 py-3 text-sm font-bold uppercase tracking-wide text-text-500 border border-text-500 rounded-full hover:bg-text-500/5 transition-colors duration-300 active:animate-press"
          >
            Say Hello
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="flex justify-center opacity-0 animate-fade-in-up [animation-delay:200ms]">
        <div class="relative w-full max-w-[340px] aspect-[4/5] rounded-[22px] overflow-hidden border-2 border-primary-200 shadow-[0_18px_40px_-18px_rgba(52,67,0,0.35)] bg-gradient-to-br from-primary-100 via-background-300 to-primary-200">
          <img
            src="/images/profile.jpg"
            alt={siteConfig.name}
            class="absolute inset-0 w-full h-full object-cover object-[50%_22%] scale-[1.12]"
          />
          <span class="absolute -top-1.5 -right-1.5 w-3.5 h-3.5 rounded-full bg-accent-500 border-2 border-background-100" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>
