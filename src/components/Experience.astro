---
import { experience } from '../data/experience';
---

<section id="experience" class="py-24 sm:py-32 bg-surface-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-12 flex items-center gap-4">
        <span class="w-8 h-1 rounded-full bg-gradient-to-r from-emerald-500 via-maroon-500 to-brown-500"></span>
        Experience
      </h2>

      <div class="grid gap-6">
        {experience.map((exp) => (
          <div class="group p-8 rounded-2xl bg-white border border-surface-200 hover:border-emerald-400 transition-colors flex flex-col sm:flex-row gap-6 shadow-sm hover:shadow-md">
            <div class="hidden sm:flex shrink-0 w-14 h-14 rounded-full bg-surface-100 items-center justify-center text-neutral-500 group-hover:bg-emerald-500 group-hover:text-white transition-colors duration-300">
              <!-- Briefcase icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>

            <div class="flex-1">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-2xl font-bold text-neutral-900 group-hover:text-emerald-600 transition-colors">{exp.role}</h3>
                  <p class="text-lg text-neutral-500 font-medium">{exp.company}</p>
                </div>
                <span class="text-sm font-semibold text-maroon-700 bg-maroon-100 border border-maroon-200 px-3 py-1 rounded-full whitespace-nowrap">{exp.dates}</span>
              </div>

              <ul class="mt-4 space-y-2 list-disc list-inside text-neutral-600">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
