---
// A single decorative layer of scattered dots + faint connecting lines that
// spans the full page height, sitting behind every section so the motif
// reads as one continuous background rather than a hero-only flourish.
const dots = [
  { top: '3%', left: '8%', size: 5, color: 'bg-primary-500' },
  { top: '6%', left: '82%', size: 4, color: 'bg-text-500' },
  { top: '11%', left: '45%', size: 3, color: 'bg-accent-500' },
  { top: '16%', left: '18%', size: 6, color: 'bg-text-500' },
  { top: '19%', left: '92%', size: 4, color: 'bg-primary-500' },
  { top: '24%', left: '60%', size: 5, color: 'bg-accent-500' },
  { top: '28%', left: '6%', size: 4, color: 'bg-primary-500' },
  { top: '33%', left: '35%', size: 3, color: 'bg-text-500' },
  { top: '37%', left: '88%', size: 5, color: 'bg-accent-500' },
  { top: '41%', left: '15%', size: 4, color: 'bg-text-500' },
  { top: '45%', left: '70%', size: 6, color: 'bg-primary-500' },
  { top: '49%', left: '48%', size: 3, color: 'bg-accent-500' },
  { top: '53%', left: '9%', size: 5, color: 'bg-text-500' },
  { top: '57%', left: '80%', size: 4, color: 'bg-primary-500' },
  { top: '61%', left: '28%', size: 4, color: 'bg-accent-500' },
  { top: '65%', left: '95%', size: 3, color: 'bg-text-500' },
  { top: '69%', left: '55%', size: 5, color: 'bg-primary-500' },
  { top: '73%', left: '12%', size: 4, color: 'bg-accent-500' },
  { top: '77%', left: '38%', size: 6, color: 'bg-text-500' },
  { top: '81%', left: '85%', size: 3, color: 'bg-primary-500' },
  { top: '85%', left: '65%', size: 4, color: 'bg-accent-500' },
  { top: '89%', left: '22%', size: 5, color: 'bg-text-500' },
  { top: '93%', left: '5%', size: 3, color: 'bg-primary-500' },
  { top: '96%', left: '75%', size: 4, color: 'bg-accent-500' },
];
const lines = [
  { top: '8%', left: '10%', width: '130px', rotate: '14deg' },
  { top: '22%', left: '65%', width: '100px', rotate: '-18deg' },
  { top: '35%', left: '20%', width: '110px', rotate: '-10deg' },
  { top: '48%', left: '75%', width: '90px', rotate: '20deg' },
  { top: '60%', left: '30%', width: '120px', rotate: '-16deg' },
  { top: '74%', left: '60%', width: '100px', rotate: '12deg' },
  { top: '88%', left: '15%', width: '110px', rotate: '-14deg' },
];
---

<div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
  {lines.map((line) => (
    <div
      class="absolute h-px bg-gradient-to-r from-transparent via-primary-500/35 to-transparent"
      style={{ top: line.top, left: line.left, width: line.width, transform: `rotate(${line.rotate})` }}
    ></div>
  ))}
  {dots.map((dot) => (
    <span
      class={`absolute rounded-full ${dot.color}`}
      style={{ top: dot.top, left: dot.left, width: `${dot.size}px`, height: `${dot.size}px` }}
    ></span>
  ))}
</div>
