---
interface Props {
  project: {
    title: string;
    description: string;
    tech: string[];
    status: string;
    githubUrl: string;
    liveUrl: string;
  };
}

const { project } = Astro.props;
---

<div class="group relative bg-slate-900/40 border border-slate-800 rounded-2xl overflow-hidden hover:border-teal-500/50 hover:bg-slate-900/80 transition-all duration-500 flex flex-col h-full">
  <div class="p-8 flex flex-col flex-grow">
    <div class="flex justify-between items-start mb-4 gap-4">
      <h3 class="text-2xl font-bold text-slate-100 group-hover:text-teal-400 transition-colors">
        {project.title}
      </h3>
      {project.status === "In Progress" && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20 whitespace-nowrap">
          In Progress
        </span>
      )}
    </div>
    
    <p class="text-slate-400 leading-relaxed mb-8 flex-grow">
      {project.description}
    </p>
    
    <div class="mt-auto">
      <div class="flex flex-wrap gap-2 mb-8">
        {project.tech.map((techItem) => (
          <span class="px-2.5 py-1 bg-slate-800/50 text-slate-300 text-xs rounded-md border border-slate-700/50">
            {techItem}
          </span>
        ))}
      </div>
      
      <div class="flex gap-6 pt-5 border-t border-slate-800/80">
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-teal-400 transition-colors flex items-center gap-2 text-sm font-medium">
          <!-- GitHub Icon -->
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          Repo
        </a>
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-teal-400 transition-colors flex items-center gap-2 text-sm font-medium">
          <!-- External Link Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          Live Demo
        </a>
      </div>
    </div>
  </div>
</div>
