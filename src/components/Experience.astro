---
import { experience } from '../data/experience';
---

<section id="experience" class="py-14 sm:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-text-500 mb-8 flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-accent-500 flex-shrink-0"></span>
        Experience
      </h2>

      <div class="flex flex-col gap-4">
        {experience.map((exp) => (
          <div class="content-card flex flex-col sm:flex-row sm:justify-between gap-3">
            <div>
              <h3 class="text-xl font-bold text-text-500">{exp.role}</h3>
              <p class="text-base text-text-500/70 mb-2">{exp.company}</p>
              <ul class="list-disc list-inside space-y-1 text-base text-text-500/80 leading-relaxed">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
            <span class="pill-tag flex-shrink-0 self-start">{exp.dates}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
