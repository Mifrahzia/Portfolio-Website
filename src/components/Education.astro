---
import { education } from '../data/education';
---

<section id="education" class="py-14 sm:py-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-text-500 mb-6 flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-sm bg-accent-500 flex-shrink-0"></span>
        Education
      </h2>

      <div class="space-y-4 relative before:absolute before:inset-0 before:ml-4 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-primary-300 before:to-transparent">
        {education.map((edu) => (
          <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
            <!-- Timeline Dot -->
            <div class="flex items-center justify-center w-8 h-8 rounded-full border-4 border-background-100 bg-primary-200 text-primary-700 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 group-hover:bg-accent-500 group-hover:text-background-100 transition-colors duration-300">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
            </div>

            <!-- Content Card -->
            <div class="w-[calc(100%-3rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-xl bg-background-50 border border-primary-200 shadow-sm group-hover:border-accent-400 group-hover:shadow-md transition-colors duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-1 gap-1">
                <h3 class="text-base font-bold text-text-500">{edu.degree}</h3>
                <span class="pill-tag flex-shrink-0">{edu.period}</span>
              </div>
              <p class="text-base text-text-500/85 font-normal">{edu.institution}</p>
              <p class="text-sm text-text-500/70">{edu.details}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
