---
import { certifications } from '../data/certifications';
---

<section id="certifications" class="py-24 sm:py-32">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-100 mb-12 flex items-center gap-4">
        <span class="w-8 h-1 bg-teal-500 rounded-full"></span>
        Certifications
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {certifications.map((cert) => (
          <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800 hover:border-teal-500/50 hover:bg-slate-900/80 transition-all duration-300 flex items-start gap-4 group">
            <div class="shrink-0 p-3 bg-teal-500/10 rounded-xl text-teal-400 group-hover:scale-110 group-hover:bg-teal-500 group-hover:text-slate-950 transition-all duration-300">
              <!-- Certificate Icon -->
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-100 mb-1">{cert.name}</h3>
              <p class="text-slate-400 text-sm font-medium uppercase tracking-wider">{cert.issuer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
